PUBLIC_SITE_URL=https://your-project.pages.dev

# Google Forms integration. Use the form's /viewform URL; the app converts it
# to /formResponse. Entry IDs come from the Google Form pre-filled link.
PUBLIC_GOOGLE_FORM_ACTION=https://docs.google.com/forms/d/e/FORM_ID/viewform
PUBLIC_GOOGLE_FORM_NAME_FIELD=0000000000
PUBLIC_GOOGLE_FORM_EMAIL_FIELD=0000000000
PUBLIC_GOOGLE_FORM_DATE_FIELD=0000000000
PUBLIC_GOOGLE_FORM_PACKAGE_FIELD=0000000000
PUBLIC_GOOGLE_FORM_MESSAGE_FIELD=0000000000