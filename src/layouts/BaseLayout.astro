---
/**
 * LG1 layout — shared gatefold frame.
 * Noir page shell: film-grain + vignette over a dark raised surface.
 * Consumed by every page (index, style-guide, …).
 */
import FilmGrain from '../components/primitives/FilmGrain.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Jon Sinatra — lounge singer and performer.',
  image = '/og.png',
} = Astro.props;

// Absolute URLs for canonical/OG so the page is identical on any static host.
// Astro.site is set at build; the env fallback keeps the same source of truth
// (PUBLIC_SITE_URL, as in astro.config.mjs) for container/unit rendering.
const origin =
  Astro.site ?? new URL(import.meta.env.PUBLIC_SITE_URL || 'https://jonsinatra.example');
const pageUrl = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(image, origin).href;
const navItems = [
  { id: 'marquee', label: 'Home' },
  { id: 'voice', label: 'The Voice' },
  { id: 'repertoire', label: 'The Repertoire' },
  { id: 'show', label: 'The Show' },
  { id: 'stage', label: 'The Stage' },
  { id: 'word', label: 'The Word' },
  { id: 'calendar', label: 'The Calendar' },
  { id: 'booking', label: 'The Booking' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#141414" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jon Sinatra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body class="m-0 bg-noir text-ivory antialiased">
    <a
      href="#main"
      class="fixed top-4 left-4 z-50 -translate-y-20 rounded-md bg-noir-lift px-4 py-2 font-mono text-mono uppercase tracking-[0.18em] text-gold opacity-0 focus:translate-y-0 focus:opacity-100"
      >Skip to content</a
    >
    <div class="relative isolate min-h-svh bg-noir">
      <FilmGrain />
      <div class="film-vignette" aria-hidden="true"></div>

      <header class="relative z-10 border-b hairline-gold-b bg-noir-soft px-6 py-4">
        <nav aria-label="Site">
          <ul
            class="mx-auto flex max-w-5xl flex-wrap gap-x-4 gap-y-2 font-mono text-mono uppercase tracking-[0.18em] text-gold"
          >
            {
              navItems.map((item) => (
                <li>
                  <a
                    class="btn inline-block scale-90 bg-transparent px-2 py-1 text-xs shadow-none hover:scale-100"
                    href={`#${item.id}`}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>

      <main id="main" tabindex="-1" class="relative z-10 mx-auto max-w-5xl px-6">
        <slot />
      </main>
    </div>
  </body>
</html>
