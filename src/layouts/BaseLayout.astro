---
/**
 * Aurelian Gallery layout — shared shell.
 * Light luxury: fixed glassmorphism header, pristine white background,
 * 1440px container with 80px desktop / 24px mobile margins.
 * Consumed by every page (index, 404, style-guide).
 */
import '../styles/global.css';
import Header from '../components/primitives/Header.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Jon Delapaz — lounge singer and performer.',
  image = '/og.jpg',
} = Astro.props;

const origin =
  Astro.site ?? new URL(import.meta.env.PUBLIC_SITE_URL || 'https://jonsinatra.example');
const pageUrl = new URL(Astro.url.pathname, origin).href;
const ogImage = new URL(image, origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcf9f8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={pageUrl} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jon Delapaz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
  </head>
  <body class="m-0 bg-surface text-on-background antialiased" id="top">
    <a
      href="#main"
      class="fixed top-4 left-4 z-60 -translate-y-20 rounded-none bg-surface-container-low px-4 py-2 font-label text-subheading-caps text-primary opacity-0 focus:translate-y-0 focus:opacity-100 transition-transform transition-opacity duration-300"
      >Skip to content</a
    >

    <!-- Glassmorphism Header (fixed, not sticky) -->
    <Header brandName="Jon Delapaz" />

    <main id="main" tabindex="-1" class="site-main pt-16 md:pt-20">
      <slot />
    </main>
  {/* variate:begin */}
  {import.meta.env.DEV && <script is:inline src="http://127.0.0.1:4504/v.js" async />}
  {/* variate:end */}
  </body>
</html>