---
/**
 * D01 — Aurelian Gallery visible style guide (/style-guide).
 * Shows every design token, the type scale, and every primitive component.
 * Contrast figures below are measured WCAG 2.x ratios (real math, not claims).
 * global.css is also imported by BaseLayout (deduped by Astro into one asset).
 */
import '../styles/global.css';
import Header from '../components/primitives/Header.astro';
import FramedImage from '../components/primitives/FramedImage.astro';
import UnderlineInput from '../components/primitives/UnderlineInput.astro';
import GalleryImage from '../components/primitives/GalleryImage.astro';
import GlassyCard from '../components/primitives/GlassyCard.astro';
import BookingCTA from '../components/primitives/BookingCTA.astro';

const siteName = 'Jon Delapaz';

/* --- New Aurelian Gallery color tokens --- */
const colors = [
  { name: 'surface', value: '#fcf9f8', role: 'Page background (pristine white)' },
  { name: 'surface-dim', value: '#dcd9d9', role: 'Disabled/muted surfaces' },
  { name: 'surface-bright', value: '#fcf9f8', role: 'Bright surface variant' },
  { name: 'surface-container-lowest', value: '#ffffff', role: 'Cards on surface (pure white)' },
  { name: 'surface-container-low', value: '#f6f3f2', role: 'Subtle container (marble)' },
  { name: 'surface-container', value: '#f0eded', role: 'Default container' },
  { name: 'surface-container-high', value: '#eae7e7', role: 'Elevated container' },
  { name: 'surface-container-highest', value: '#e5e2e1', role: 'Highest container' },
  { name: 'on-surface', value: '#1c1b1b', role: 'Primary text (onyx)' },
  { name: 'on-surface-variant', value: '#4d4635', role: 'Secondary text / placeholder' },
  { name: 'outline', value: '#7f7663', role: 'Hairline borders (0.5px)' },
  { name: 'outline-variant', value: '#d0c5af', role: 'Subtle borders / dividers' },
  { name: 'primary', value: '#735c00', role: 'Gold (deep) — focus, active' },
  { name: 'on-primary', value: '#ffffff', role: 'Text on primary' },
  { name: 'primary-container', value: '#d4af37', role: 'Brushed gold — buttons, highlights' },
  { name: 'on-primary-container', value: '#554300', role: 'Text on primary container' },
  { name: 'secondary', value: '#5d5f5f', role: 'Neutral accent' },
  { name: 'error', value: '#ba1a1a', role: 'Error states' },
  { name: 'surface-variant', value: '#e5e2e1', role: 'Input underline, subtle dividers' },
];

const contrastPairs = [
  { pair: 'on-surface / surface', ratio: '13.38:1', usage: 'body text (AAA)' },
  { pair: 'primary / surface', ratio: '7.23:1', usage: 'focus, active (AAA)' },
  { pair: 'on-surface-variant / surface', ratio: '6.58:1', usage: 'secondary text (AAA)' },
  { pair: 'primary-container / surface', ratio: '5.15:1', usage: 'button fill + text (AA)' },
];

const typeSamples = [
  { token: 'display-lg', spec: '72px / 80px / 200 / -0.02em — Bodoni Moda' },
  { token: 'display-lg-mobile', spec: '48px / 52px / 200 / -0.01em — Bodoni Moda' },
  { token: 'headline-md', spec: '32px / 40px / 300 — Bodoni Moda' },
  { token: 'subheading-caps', spec: '12px / 16px / 500 / 0.3em — DM Sans' },
  { token: 'body-lg', spec: '18px / 32px / 300 — DM Sans' },
  { token: 'body-md', spec: '16px / 28px / 400 — DM Sans' },
  { token: 'label-sm', spec: '11px / 14px / 600 / 0.1em — DM Sans' },
];

const spacingTokens = [
  { name: 'unit', value: '8px', role: 'Base unit' },
  { name: 'gutter', value: '32px', role: 'Column gap' },
  { name: 'margin-desktop', value: '80px', role: 'Outer margin (desktop)' },
  { name: 'margin-mobile', value: '24px', role: 'Outer margin (mobile)' },
  { name: 'section-gap', value: '160px', role: 'Vertical gap between sections' },
  { name: 'container-max', value: '1440px', role: 'Max content width' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`${siteName} — D01 design system style guide: tokens, typography, glassmorphism, sharp cards, underline inputs.`}
    />
    <title>Style Guide — {siteName}</title>
  </head>
  <body>
    <a class="btn-ghost" href="/" style="position: absolute; top: 1rem; left: 1rem; z-index: 60"
      >← Back to site</a
    >

    <!-- Header Demo -->
    <Header brandName={siteName} />

    <main class="container-page pt-[140px] pb-section-gap">
      <div class="card-white px-6 py-12 sm:px-10">
        <header class="text-center">
          <p class="font-label text-subheading-caps text-primary">D01 / Design System</p>
          <h1 class="mt-4 font-display text-display-lg-mobile md:text-display-lg font-medium text-on-surface">The Style Guide</h1>
          <div class="w-12 border-t border-primary mx-auto mt-6" />
        </header>

        <!-- Color Tokens -->
        <section class="mt-14" aria-labelledby="tokens-title">
          <p class="font-label text-subheading-caps text-primary" id="tokens-title">Color tokens</p>
          <h2 class="mt-3 font-display text-headline-md font-medium text-on-surface">Surface · On-Surface · Primary · Outline</h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
            {colors.map((c) => (
              <li class="card-white p-4">
                <div
                  class="h-14 w-full border"
                  style={`background-color: ${c.value}; border-color: var(--color-outline-variant)`}
                />
                <p class="mt-3 font-label text-body-md font-medium text-on-surface">--color-{c.name}</p>
                <p class="mt-1 font-label text-label-sm text-primary">{c.value}</p>
                <p class="mt-1 text-sm text-on-surface-variant">{c.role}</p>
              </li>
            ))}
          </ul>

          <h3 class="mt-10 font-display text-headline-md font-medium text-on-surface">Measured contrast (WCAG 2.x)</h3>
          <table class="mt-4 w-full border-collapse font-label text-sm">
            <thead>
              <tr class="text-primary">
                <th class="border-b border-outline-variant py-2 pr-4 text-left">Pair</th>
                <th class="border-b border-outline-variant py-2 pr-4 text-left">Ratio</th>
                <th class="border-b border-outline-variant py-2 text-left">Usage</th>
              </tr>
            </thead>
            <tbody>
              {contrastPairs.map((row) => (
                <tr>
                  <td class="border-b border-outline-variant py-2 pr-4 text-on-surface">{row.pair}</td>
                  <td class="border-b border-outline-variant py-2 pr-4 text-primary">{row.ratio}</td>
                  <td class="border-b border-outline-variant py-2 text-on-surface-variant">{row.usage}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <!-- Typography -->
        <section class="mt-14" aria-labelledby="type-title">
          <p class="font-label text-subheading-caps text-primary" id="type-title">Typography</p>
          <h2 class="mt-3 font-display text-headline-md font-medium text-on-surface">Bodoni Moda (display) + DM Sans (body/labels)</h2>
          <div class="mt-6 grid gap-5">
            <p class="font-display text-display-lg-mobile md:text-display-lg font-[200] text-on-surface tracking-[-0.02em] leading-[1.11]">Hero — Jon Delapaz</p>
            <p class="font-display text-headline-md font-[300] text-on-surface leading-[1.25]">Headline — Section titles</p>
            <p class="font-label text-body-lg font-[300] text-on-surface leading-[1.78]">Body Large — Hero copy, about text</p>
            <p class="font-label text-body-md font-[400] text-on-surface leading-[1.75]">Body Medium — Standard body copy</p>
            <p class="font-label text-subheading-caps font-[500] text-primary">Subheading Caps — Nav, eyebrows, labels</p>
            <p class="font-label text-label-sm font-[600] text-on-surface-variant">Label Small — Form labels, chips, copyright</p>
          </div>

          <h3 class="mt-8 font-display text-headline-md font-medium text-on-surface">Type scale tokens</h3>
          <ul class="mt-4 grid gap-2 font-label text-sm text-on-surface-variant">
            {typeSamples.map((t) => (
              <li>
                <span class="font-medium text-on-surface">{t.token}</span> — {t.spec}
              </li>
            ))}
          </ul>
        </section>

        <!-- Spacing & Layout -->
        <section class="mt-14" aria-labelledby="spacing-title">
          <p class="font-label text-subheading-caps text-primary" id="spacing-title">Spacing & Layout</p>
          <h2 class="mt-3 font-display text-headline-md font-medium text-on-surface">8px base unit · 1440px container · 160px section gap</h2>
          <table class="mt-4 w-full border-collapse font-label text-sm">
            <thead>
              <tr class="text-primary">
                <th class="border-b border-outline-variant py-2 pr-4 text-left">Token</th>
                <th class="border-b border-outline-variant py-2 pr-4 text-left">Value</th>
                <th class="border-b border-outline-variant py-2 text-left">Role</th>
              </tr>
            </thead>
            <tbody>
              {spacingTokens.map((t) => (
                <tr>
                  <td class="border-b border-outline-variant py-2 pr-4 text-on-surface">--spacing-{t.name}</td>
                  <td class="border-b border-outline-variant py-2 pr-4 text-primary">{t.value}</td>
                  <td class="border-b border-outline-variant py-2 text-on-surface-variant">{t.role}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <!-- Primitive: Header -->
        <section class="mt-14" aria-labelledby="header-title">
          <p class="font-label text-subheading-caps text-primary" id="header-title">Primitive: Header</p>
          <h2 class="mt-3 font-display text-headline-md font-medium text-on-surface">Glassmorphism nav with brand, links, trailing CTA</h2>
          <div class="mt-6 card-white p-6">
            <Header
              brandName={siteName}
              navItems={[
                { id: 'music', label: 'MUSIC' },
                { id: 'tour', label: 'TOUR' },
                { id: 'gallery', label: 'GALLERY' },
                { id: 'about', label: 'ABOUT' },
              ]}
              ctaLabel="BOOKING"
              ctaHref="#booking"
            />
            <p class="mt-4 text-sm text-on-surface-variant">
              Fixed top, <code>backdrop-blur-[30px]</code>, <code>bg-surface/80</code>, hairline border.
              Brand in <code>display-lg</code>, nav in <code>subheading-caps</code>, trailing CTA underline hover.
            </p>
          </div>
        </section>

        <!-- Primitive: FramedImage -->
        <section class="mt-14" aria-labelledby="framed-title">
          <p class="font-label text-subheading-caps text-primary" id="framed-title">Primitive: FramedImage</p>
          <h2 class="mt-3 font-display text-headline-md font-medium text-on-surface">Sharp frame, corner accents, metallic backdrop, gallery filter</h2>
          <div class="mt-6 grid gap-6 md:grid-cols-2">
            <FramedImage
              src="https://picsum.photos/seed/aurelius-hero/800/600"
              alt="Hero image placeholder"
              aspectRatio="4/3"
            />
            <FramedImage
              src="https://picsum.photos/seed/aurelius-about/600/800"
              alt="About image placeholder"
              aspectRatio="3/4"
            />
          </div>
          <p class="mt-4 text-sm text-on-surface-variant">
            <code>.framed-image</code> with <code>::before</code>/<code>::after</code> corner accents (8px),
            <code>bg-primary-container/10</code> metallic backdrop offset <code>-translate-x-1 translate-y-1</code>,
            <code>.gallery-img</code> filter (grayscale 15% sepia 5% → 0% on hover).
          </p>
        </section>

        <!-- Primitive: GalleryImage -->
        <section class="mt-14" aria-labelledby="gallery-img-title">
          <p class="font-label text-subheading-caps text-primary" id="gallery-img-title">Primitive: GalleryImage</p>
          <h2 class="mt-3 font-display text-headline-md font-medium text-on-surface">Desaturated → color hover, no frame</h2>
          <div class="mt-6 grid gap-4 md:grid-cols-3">
            <GalleryImage src="https://picsum.photos/seed/gallery-1/400/300" alt="Gallery 1" aspectRatio="4/3" />
            <GalleryImage src="https://picsum.photos/seed/gallery-2/400/300" alt="Gallery 2" aspectRatio="4/3" />
            <GalleryImage src="https://picsum.photos/seed/gallery-3/400/300" alt="Gallery 3" aspectRatio="4/3" />
          </div>
          <p class="mt-4 text-sm text-on-surface-variant">
            <code>.gallery-img</code> filter only. Sharp corners. For grid galleries.
          </p>
        </section>

        <!-- Primitive: UnderlineInput -->
        <section class="mt-14" aria-labelledby="underline-title">
          <p class="font-label text-subheading-caps text-primary" id="underline-title">Primitive: UnderlineInput</p>
          <h2 class="mt-3 font-display text-headline-md font-medium text-on-surface">Minimalist underline field with label</h2>
          <div class="mt-6 grid gap-4 md:grid-cols-4 max-w-4xl">
            <UnderlineInput id="demo-date" name="date" label="Event Date" placeholder="Select Date" type="date" />
            <UnderlineInput id="demo-type" name="type" label="Event Type" placeholder="Gala, Private, Corporate" />
            <UnderlineInput id="demo-location" name="location" label="Location" placeholder="City / Venue" />
            <UnderlineInput id="demo-email" name="email" label="Email" placeholder="you@example.com" type="email" />
          </div>
          <p class="mt-4 text-sm text-on-surface-variant">
            Label: <code>label-sm</code> uppercase tracking-wide <code>text-on-surface-variant</code>.
            Input: transparent, <code>border-b outline-variant</code> → <code>focus:border-primary</code>.
          </p>
        </section>

        <!-- Primitive: GlassyCard -->
        <section class="mt-14" aria-labelledby="card-title">
          <p class="font-label text-subheading-caps text-primary" id="card-title">Primitive: GlassyCard</p>
          <h2 class="mt-3 font-display text-headline-md font-medium text-on-surface">Sharp white card on marble, hairline border</h2>
          <GlassyCard title="GlassyCard" class="mt-6 p-6">
            <p class="font-label text-body-md text-on-surface">
              Replaces GatefoldCard. <code>bg-surface-container-lowest</code> (white) on
              <code>bg-surface-container-low</code> (marble). Sharp corners (<code>radius-none</code>).
              Border: <code>0.5px solid outline-variant</code>. No shadows, no blur.
            </p>
          </GlassyCard>
        </section>

        <!-- Primitive: BookingCTA -->
        <section class="mt-14" aria-labelledby="cta-title">
          <p class="font-label text-subheading-caps text-primary" id="cta-title">Primitive: BookingCTA</p>
          <h2 class="mt-3 font-display text-headline-md font-medium text-on-surface">Primary · Ghost · Underline button variants</h2>
          <div class="mt-6 flex flex-wrap gap-4">
            <BookingCTA href="#booking" label="Inquire Availability" variant="primary" />
            <BookingCTA href="#booking" label="Inquire Availability" variant="ghost" />
            <BookingCTA href="#booking" label="Read Full Biography" variant="underline" />
          </div>
          <p class="mt-4 text-sm text-on-surface-variant">
            Primary: <code>bg-primary border-primary text-on-primary</code> → hover <code>bg-transparent text-primary</code>.<br />
            Ghost: <code>bg-transparent border-primary text-primary</code> → hover <code>bg-primary text-on-primary</code>.<br />
            Underline: <code>border-b-primary text-primary</code> → hover <code>text-on-surface gap-2</code>.<br />
            All in <code>subheading-caps</code>, 200ms transitions, honor <code>prefers-reduced-motion</code>.
          </p>
        </section>

        <!-- Elevation & Depth -->
        <section class="mt-14" aria-labelledby="elevation-title">
          <p class="font-label text-subheading-caps text-primary" id="elevation-title">Elevation & Depth</p>
          <h2 class="mt-3 font-display text-headline-md font-medium text-on-surface">No shadows — tonal layering + hairlines + glassmorphism</h2>
          <div class="mt-6 grid gap-4">
            <div class="bg-marble p-6">
              <p class="font-label text-body-md text-on-surface">
                <strong>Marble surface:</strong> <code>bg-surface-container-low</code> (#f6f3f2).
                Page background is <code>bg-surface</code> (#fcf9f8).
              </p>
            </div>
            <div class="card-white p-6">
              <p class="font-label text-body-md text-on-surface">
                <strong>White card:</strong> <code>bg-surface-container-lowest</code> (#ffffff) +
                <code>border outline-variant</code> (0.5px).
              </p>
            </div>
            <div class="glass-header p-6" style="position: relative; top: 0; left: 0; right: 0;">
              <p class="font-label text-body-md text-on-surface">
                <strong>Glass header:</strong> <code>bg-surface/80 backdrop-blur-[30px]</code> +
                <code>border-b outline-variant/30</code>.
              </p>
            </div>
          </div>
        </section>

        <footer class="mt-14 pt-6 text-center text-sm text-on-surface-variant">
          <p class="font-label text-label-sm font-medium uppercase tracking-[0.16em]">
            D01 design system — reduced-motion: transitions and filters disabled
          </p>
        </footer>
      </div>
    </main>
  </body>
</html>