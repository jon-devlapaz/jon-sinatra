---
/**
 * D01 — visible style guide (/style-guide).
 * Shows every design token, the type scale, and every primitive component.
 * Contrast figures below are measured WCAG 2.x ratios (real math, not claims).
 * global.css is also imported by BaseLayout (deduped by Astro into one asset).
 */
import '../styles/global.css';
import GatefoldCard from '../components/primitives/GatefoldCard.astro';
import TicketStub from '../components/primitives/TicketStub.astro';

const siteName = 'Jon Delapaz';
const colors = [
  { name: 'paper', value: '#F4EFE6', role: 'Warm parchment base' },
  { name: 'paper-deep', value: '#ECE3D2', role: 'Deeper paper (header, footer)' },
  { name: 'paper-lift', value: '#FBF8F1', role: 'Elevated surfaces on paper' },
  { name: 'ink', value: '#2B241B', role: 'Primary text — warm near-black' },
  { name: 'ink-soft', value: '#5D5344', role: 'Secondary text (6.58:1)' },
  { name: 'ink-faint', value: '#A89D8C', role: 'Placeholder/hover — never small text' },
  { name: 'accent', value: '#8A5A1B', role: 'Bronze — buttons, labels, 5.15:1' },
  { name: 'accent-deep', value: '#6F4510', role: 'Deep bronze emphasis (7.23:1)' },
  { name: 'accent-soft', value: '#C9A66B', role: 'Decoration only (rules, dots)' },
];
const contrastPairs = [
  { pair: 'ink / paper', ratio: '13.38:1', usage: 'body text (AAA)' },
  { pair: 'accent-deep / paper', ratio: '7.23:1', usage: 'eyebrows, labels, values (AAA)' },
  { pair: 'ink-soft / paper', ratio: '6.58:1', usage: 'secondary text (AAA)' },
  { pair: 'accent / paper', ratio: '5.15:1', usage: 'button fill + text (AA)' },
];
const typeSamples = [
  { token: 'Hero', spec: 'clamp(2.5rem → 4rem) · weight 300 · tight tracking' },
  { token: 'Display', spec: 'clamp(1.5rem → 2.25rem) · weight 500' },
  { token: 'Title', spec: 'clamp(1.125rem → 1.5rem) · weight 600' },
  { token: 'Body', spec: 'clamp(1rem → 1.125rem) · weight 400 · 1.6' },
  { token: 'Label', spec: '0.75rem · weight 600 · uppercase · 0.12–0.18em' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={`${siteName} — D01 design system style guide: tokens, typography, glassy card, pill buttons.`}
    />
    <title>Style Guide — {siteName}</title>
  </head>
  <body>
    <a class="btn btn--ghost" href="/" style="position: absolute; top: 1rem; left: 1rem"
      >← Back to site</a
    >

    <main class="mx-auto w-full max-w-2xl px-5 py-12">
      <div class="card px-6 py-12 sm:px-10">
        <header class="text-center">
          <p class="eyebrow">D01 / Design System</p>
          <h1 class="mt-4 text-display font-medium text-ink">The Style Guide</h1>
          <div class="rule mx-auto mt-6 w-40"></div>
        </header>

        <!-- Hero / intro block demo -->
        <section class="mt-14" aria-labelledby="hero-title">
          <p class="eyebrow text-center" id="hero-title">Intro block — centered marquee</p>
          <div class="marquee mt-6">
            <p class="marquee-sub">Now appearing — weddings &amp; late-night bars</p>
            <h2 class="marquee-name text-ink">{siteName}</h2>
            <div class="rule w-24"></div>
          </div>
        </section>

        <!-- Tokens -->
        <section class="mt-14" aria-labelledby="tokens-title">
          <p class="eyebrow" id="tokens-title">Color tokens — paper · ink · bronze</p>
          <h2 class="mt-3 text-display font-medium text-ink">Tokens</h2>
          <ul class="mt-6 grid gap-4 sm:grid-cols-2">
            {
              colors.map((c) => (
                <li class="gatefold" style="padding: 1.25rem">
                  <div
                    class="h-14 w-14 rounded-lg border"
                    style={`background-color: ${c.value}; border-color: var(--color-card-border)`}
                  />
                  <p class="mt-4 font-sans text-sm font-medium text-ink">--color-{c.name}</p>
                  <p class="mt-1 font-sans text-sm text-accent-deep">{c.value}</p>
                  <p class="mt-1 text-sm text-ink-soft">{c.role}</p>
                </li>
              ))
            }
          </ul>

          <h3 class="mt-10 text-title font-medium text-ink">Measured contrast (WCAG 2.x)</h3>
          <table class="mt-4 w-full border-collapse font-sans text-sm">
            <thead>
              <tr class="text-accent-deep">
                <th class="border-b border-card-border py-2 pr-4 text-left">Pair</th>
                <th class="border-b border-card-border py-2 pr-4 text-left">Ratio</th>
                <th class="border-b border-card-border py-2 text-left">Usage</th>
              </tr>
            </thead>
            <tbody>
              {
                contrastPairs.map((row) => (
                  <tr>
                    <td class="border-b border-card-border py-2 pr-4 text-ink">{row.pair}</td>
                    <td class="border-b border-card-border py-2 pr-4 text-accent-deep">
                      {row.ratio}
                    </td>
                    <td class="border-b border-card-border py-2 text-ink-soft">{row.usage}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </section>

        <!-- Typography -->
        <section class="mt-14" aria-labelledby="type-title">
          <p class="eyebrow" id="type-title">Typography — Inter (self-hosted)</p>
          <h2 class="mt-3 text-display font-medium text-ink">Type scale</h2>
          <div class="mt-6 grid gap-5">
            <p class="text-hero font-light text-ink">Hero — Jon Delapaz</p>
            <p class="text-display font-medium text-ink">Display — for section titles</p>
            <p class="text-title font-semibold text-ink">Title — cards, stub headlines</p>
            <p class="text-body text-ink">
              Body — Inter at 16–18px / 1.6, weight 400. Light and airy on warm paper.
            </p>
            <p class="eyebrow">Label — eyebrows, form labels, facts</p>
            <ul class="mt-2 grid gap-1 font-sans text-sm text-ink-soft">
              {
                typeSamples.map((t) => (
                  <li>
                    <span class="font-semibold text-ink">{t.token}</span> — {t.spec}
                  </li>
                ))
              }
            </ul>
          </div>
        </section>

        <!-- Glassy card + dotted texture -->
        <section class="mt-14" aria-labelledby="card-title">
          <p class="eyebrow" id="card-title">Shell — glassy card on parchment</p>
          <h2 class="mt-3 text-display font-medium text-ink">Card &amp; texture</h2>
          <div class="card mt-6 p-6">
            <p class="text-body text-ink">
              Semi-transparent paper, a soft low-opacity border, backdrop blur, and a subtle inner
              highlight along the top edge. The page background layers a faint dotted texture and a
              warm radial glow.
            </p>
          </div>
          <div class="mt-4 flex flex-wrap gap-4">
            <a class="btn" href="#booking">Primary pill</a>
            <a class="btn btn--ghost" href="#booking">Ghost pill</a>
            <a class="btn btn--link" href="#booking">Text link</a>
            <a class="btn btn--circle" href="#booking" aria-label="Book the show">→</a>
            <button class="btn" type="button" disabled> Disabled </button>
          </div>
          <p class="mt-4 text-sm text-ink-soft">
            Buttons transition in ~200ms, a processing state adds a subtle scale/contrast dip and a
            spinner, and everything honors prefers-reduced-motion.
          </p>
        </section>

        <!-- Booking CTA -->
        <section class="mt-14" aria-labelledby="stub-title">
          <p class="eyebrow" id="stub-title">Booking CTA</p>
          <h2 class="mt-3 text-display font-medium text-ink">The Stub</h2>
          <TicketStub
            href="#booking"
            label="Book the show"
            eyebrow="Cocktail Hour"
            title="Two-hour lounge set"
            stubValue="Enquire"
            status="On request"
          />
          <p class="mt-4 max-w-prose text-sm text-ink-soft">
            A quiet glassy card: eyebrow, headline, status and value, and a real labelled anchor.
          </p>
        </section>

        <!-- Primitives -->
        <section class="mt-14" aria-labelledby="primitives-title">
          <p class="eyebrow" id="primitives-title">Layout primitives</p>
          <h2 class="mt-3 text-display font-medium text-ink">Cards &amp; hairlines</h2>
          <div class="mt-6 grid gap-6">
            <GatefoldCard title="Glassy panel">
              <p class="mt-2 text-sm text-ink-soft">
                The package-tier card from the Show: soft border, translucent paper, rounded
                corners.
              </p>
            </GatefoldCard>
            <div class="gatefold">
              <h3 class="gatefold__title">Soft rules</h3>
              <div class="rule mt-4"></div>
              <p class="mt-4 text-sm text-ink-soft">
                1px bronze rules and low-opacity borders — bronze for trim, never a fill.
              </p>
            </div>
          </div>
        </section>

        <!-- Supporting primitives -->
        <section class="mt-14" aria-labelledby="support-title">
          <p class="eyebrow" id="support-title">Supporting primitives</p>
          <h2 class="mt-3 text-display font-medium text-ink">Facts strip &amp; media frame</h2>
          <dl class="facts-strip mt-6">
            <div>
              <dt>Range</dt>
              <dd>Baritone</dd>
            </div>
            <div>
              <dt>Venue</dt>
              <dd>Weddings</dd>
            </div>
            <div>
              <dt>Bookings</dt>
              <dd>Open</dd>
            </div>
          </dl>
          <div class="media-frame mt-6">
            <p
              class="absolute inset-0 grid place-items-center px-8 text-center text-sm text-ink-soft"
            >
              Media frame — audio/video/photo slots land here.
            </p>
          </div>
        </section>

        <footer class="mt-14 pt-6 text-center text-sm text-ink-soft">
          <p class="font-sans text-sm font-medium uppercase tracking-[0.16em]">
            D01 design system — reduced-motion: transitions and spinners disabled
          </p>
        </footer>
      </div>
    </main>
  </body>
</html>
