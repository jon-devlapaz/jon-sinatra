---
/**
 * I01 — 404 page. Styled to the theme: an off-night poster, a backstage
 * joke, and a ticket-stub CTA home. Every unknown route lands here.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — The wrong door" description="The page you're after isn't in the set list.">
  <section class="py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-6 text-display text-ivory">The wrong door.</h1>
    <p class="mx-auto mt-4 max-w-md text-ivory-dim">
      The page you're after isn't in the set list. Even the great ones hit a wrong note now and then
      — step back to the main stage.
    </p>
    <div class="mt-10">
      <a class="btn" href="/#marquee">Back to the main stage</a>
    </div>
  </section>
</BaseLayout>
