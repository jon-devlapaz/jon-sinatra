---
/**
 * Page: index — the single-page performer profile (minimal: About → Music →
 * Book → Contact). Composed from D01 primitives. The F08 booking island is
 * enhanced by React in LG3; everything else is static.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Marquee from '../components/sections/Marquee.astro';
import Bio from '../components/sections/Bio.astro';
import Music from '../components/sections/Music.astro';
import BookingShell from '../components/sections/BookingShell.astro';
import Footer from '../components/sections/Footer.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title={`${profile.name} — Classic Oldies Crooner`}
  description={profile.tagline}
  image="/og.jpg"
>
  <Marquee name={profile.name} subtitle={profile.marqueeSubtitle} tagline={profile.tagline} />
  <Bio profile={profile} />
  <Music />
  <BookingShell profile={profile} />
  <Footer profile={profile} />
</BaseLayout>
