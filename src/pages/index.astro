---
/**
 * Page: index — Aurelian Gallery single-page performer profile.
 * Sections: Hero → About → BookingBar → Footer.
 * Header rendered via BaseLayout.
 * BookingForm React island hydrates on the BookingBar shell.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Music from '../components/sections/Music.astro';
import BookingShell from '../components/sections/BookingShell.astro';
import InfoSections from '../components/sections/InfoSections.astro';
import Footer from '../components/sections/Footer.astro';
import { profile } from '../data/profile';

const packageId = Astro.url.searchParams.get('package') || undefined;
const date = Astro.url.searchParams.get('date') || undefined;
---

<BaseLayout
  title={`${profile.name} — Lounge Singer & Performer`}
  description={profile.heroBody}
  image={profile.heroImage.src}
>
  <Hero
    name={profile.name}
    subtitle={profile.heroSubtitle}
    body={profile.heroBody}
    image={profile.heroImage}
    ctaHref="#booking"
    ctaLabel="Talk about your event"
  />
<About
  eyebrow={profile.aboutEyebrow}
     headline={profile.aboutHeadline}
     body={profile.aboutBody}
     link={profile.aboutLink}
   />
   <Music />
   <BookingShell profile={profile} packageId={packageId} date={date} />
  <InfoSections email={profile.contact.email} />
   <Footer
     brandName={profile.name}
     links={profile.footerLinks}
   />
</BaseLayout>