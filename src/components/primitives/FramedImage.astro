---
/**
 * D01 Primitive — FramedImage.
 * Sharp-edged image frame with corner accents (top-left & bottom-right),
 * gallery-img filter (desaturated → color on hover), optional aspect ratio.
 * Consumed by Hero, About sections.
 */
interface Props {
  src: string;
  alt: string;
  aspectRatio?: '4/3' | '16/9' | '1/1' | '3/4';
  class?: string;
}

const { src, alt, aspectRatio = '4/3', class: className = '' } = Astro.props;

const aspectClass = {
  '4/3': 'aspect-[4/3]',
  '16/9': 'aspect-video',
  '1/1': 'aspect-square',
  '3/4': 'aspect-[3/4]',
}[aspectRatio];

---

<div
  class={`framed-image relative overflow-hidden bg-surface-container-low ${aspectClass} ${className}`}
  role="img"
  aria-label={alt}
>
  <!-- Metallic accent backdrop -->
  <div class="absolute inset-0 bg-primary-container/10 -translate-x-1 translate-y-1 border-[0.5px] border-primary" aria-hidden="true" />
  <img
    class="gallery-img relative z-10 object-cover w-full h-full"
    src={src}
    alt={alt}
    loading="lazy"
  />
</div>