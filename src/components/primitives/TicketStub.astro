---
/**
 * D01 primitive — booking CTA.
 * A quiet glassy card: eyebrow, headline, status + value, and a real labelled
 * anchor.
 */
interface Props {
  href: string;
  /** CTA label, e.g. "Book the show". */
  label: string;
  /** Mono eyebrow, e.g. package name "Cocktail Hour". */
  eyebrow?: string;
  /** Headline, e.g. "Two-hour lounge set". */
  title: string;
  /** Mono value, e.g. "Enquire" or an availability note. */
  stubValue: string;
  /** Optional real-text status, e.g. "On request" or "Open". */
  status?: string;
}

const { href, label, eyebrow, title, stubValue, status } = Astro.props;
---

<article class="ticket-stub">
  <div class="ticket-stub__main">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h3 class="ticket-stub__title">{title}</h3>
    <div class="ticket-stub__row">
      {
        status && (
          <p class="ticket-stub__status" role="status">
            {status}
          </p>
        )
      }
      <p class="ticket-stub__value">{stubValue}</p>
    </div>
    <a class="btn ticket-stub__cta" href={href} aria-label={`${label}: ${title}`}>
      <span>{label}</span>
    </a>
  </div>
</article>
