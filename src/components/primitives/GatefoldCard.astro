---
/**
 * D01 primitive — glassy card.
 * A raised glassy panel with a soft border; slots arbitrary content.
 * Consumed by F04 package tiers and the style guide.
 */
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
const cardClass = ['gatefold', className].filter(Boolean).join(' ');
---

<section class={cardClass}>
  {title && <h3 class="gatefold__title">{title}</h3>}
  <slot />
</section>
