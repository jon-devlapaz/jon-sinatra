---
/**
 * D01 primitive — composable film-grain overlay (evidence C3).
 * Place inside a `position: relative; isolation: isolate` container and put
 * content on a z-index above the overlay. The element is empty, aria-hidden,
 * pointer-events:none; drift freezes under prefers-reduced-motion.
 */
interface Props {
  class?: string;
  /** Freeze the drift animation even when motion is allowed. */
  static?: boolean;
}

const { class: className = '', static: isStatic = false } = Astro.props;
const grainClass = ['film-grain', isStatic && 'film-grain--static', className]
  .filter(Boolean)
  .join(' ');
---

<div class={grainClass} aria-hidden="true"></div>
