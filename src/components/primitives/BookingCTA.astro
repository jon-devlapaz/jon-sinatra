---
/**
 * D01 Primitive — BookingCTA.
 * Simple button variants: primary (gold fill) and ghost (gold border).
 * Replaces TicketStub (notch, barcode, complex layout).
 * Consumed by Hero, BookingBar, Footer, style guide.
 */
type Variant = 'primary' | 'ghost' | 'underline';

interface Props {
  href: string;
  label: string;
  variant?: Variant;
  class?: string;
  ariaLabel?: string;
}

const { href, label, variant = 'primary', class: className = '', ariaLabel } = Astro.props;

const variantClass = {
  primary: 'btn-primary',
  ghost: 'btn-ghost',
  underline: 'btn-underline',
}[variant];

---

<a
  class={`${variantClass} ${className}`}
  href={href}
  aria-label={ariaLabel || label}
>
  {label}
</a>