---
/**
 * F02 — About.
 * Bio: portrait (media-frame placeholder until a real asset lands), key facts
 * strip, and a pull quote in the site's voice.
 */
import type { Fact, Profile } from '../../data/profile';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;

function initials(str: string): string {
  return str
    .split(' ')
    .map((w) => w[0])
    .join('')
    .toUpperCase();
}
---

<section id="about" class="py-24" aria-labelledby="about-title">
  <div class="grid gap-12 md:grid-cols-[16rem_1fr] items-start">
    <!-- C3 — portrait frame (no asset: themed placeholder) -->
    <div class="media-frame">
      <div class="absolute inset-0 grid place-items-center">
        <span class="text-5xl text-ink-soft">{initials(profile.name)}</span>
      </div>
    </div>

    <div>
      <p class="eyebrow" id="about-eyebrow">About me</p>
      <h2 class="text-display font-medium text-ink" id="about-title">{profile.name}</h2>
      <div class="rule my-6 w-24"></div>

      <p class="text-ink">{profile.bio}</p>

      <blockquote class="my-10 border-l-2 border-accent-soft pl-6 italic text-ink-soft">
        "{profile.quote}"
      </blockquote>

      <dl class="facts-strip">
        {
          profile.facts.map((f: Fact) => (
            <>
              <dt>{f.dt}</dt>
              <dd>{f.dd}</dd>
            </>
          ))
        }
      </dl>
    </div>
  </div>
</section>
