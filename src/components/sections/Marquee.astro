---
/**
 * F01 — The Marquee (now a quiet centered intro inside the card).
 * Eyebrow, hero name, tagline, and the availability card + a ghost link into
 * the booking form.
 */
import TicketStub from '../../components/primitives/TicketStub.astro';

interface Props {
  name: string;
  subtitle: string;
  tagline: string;
}
const { name, subtitle, tagline } = Astro.props;
---

<section id="marquee" aria-label="Marquee">
  <div class="marquee">
    <p class="marquee-sub" id="marquee-sub">{subtitle}</p>
    <h1 class="marquee-name text-ink" id="marquee-name">{name}</h1>
    <p class="mx-auto max-w-md text-ink-soft">{tagline}</p>
    <div class="mt-6 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <TicketStub
        href="#booking?package=standard"
        label="Book the show"
        eyebrow="Availability"
        title="Check your date"
        stubValue="Open"
        status="Open"
      />
      <a class="btn btn--ghost" href="#stage">View the stage</a>
    </div>
  </div>
</section>
