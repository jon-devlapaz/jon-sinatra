---
/**
 * F01 — The Marquee.
 * Full-viewport film title card: marquee name, subtitle, primary ticket-stub
 * CTA into the booking form, and a secondary CTA to the gallery (#stage).
 */
import TicketStub from '../../components/primitives/TicketStub.astro';

interface Props {
  name: string;
  subtitle: string;
  tagline: string;
}
const { name, subtitle, tagline } = Astro.props;
---

<section id="marquee" aria-label="Marquee">
  <div class="title-card">
    <div class="marquee">
      <p class="marquee-sub" id="marquee-sub">{subtitle}</p>
      <h1 class="marquee-name text-ivory" id="marquee-name">{name}</h1>
      <p class="mt-4 max-w-2xl text-center text-ivory-dim">{tagline}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <TicketStub
          href="#booking?package=standard"
          label="Book the show"
          eyebrow="Availability"
          title="Check your date"
          stubValue="Open"
          status="Open"
        />
        <a class="btn" href="#stage">View the stage</a>
      </div>
    </div>
  </div>
</section>
