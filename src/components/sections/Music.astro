---
/**
 * F02 — Music section and placeholder setlist.
 */
import { tracks } from '../../data/music';
---
<section id="music" class="section-gap" aria-labelledby="music-title">
  <div class="container-page">
    <p class="font-label text-subheading-caps text-primary">The setlist</p>
    <h2 class="mt-3 font-display text-headline-md font-medium text-on-surface" id="music-title">
      Songs people know and love
    </h2>
    <p class="mt-4 max-w-xl text-on-surface-variant font-light leading-loose">
      These are a few of the songs I love to sing. More recordings are on the way, but this is the sound I’m building around Sinatra, Dean Martin, and the great American songbook.
    </p>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {tracks.map((track, index) => (
        <article class="card-white flex flex-col gap-5 p-6" aria-labelledby={`${track.id}-title`}>
          <div class="flex items-start gap-4">
            <span class="font-label text-label-sm text-primary" aria-hidden="true">0{index + 1}</span>
            <div>
              <h3 class="font-display text-[26px] leading-tight text-on-surface" id={`${track.id}-title`}>
                {track.title}
              </h3>
              <p class="mt-1 font-label text-label-sm text-on-surface-variant">{track.artist}</p>
            </div>
          </div>
          <p class="text-on-surface-variant font-light leading-relaxed">{track.note}</p>
          {track.src ? (
            <audio controls class="w-full" aria-label={`Preview of ${track.title}`}>
              <source src={track.src} type="audio/mpeg" />
              Your browser does not support audio playback.
            </audio>
          ) : (
            <p class="font-label text-label-sm text-primary">More recordings on the way</p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>