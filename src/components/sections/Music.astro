---
/**
 * Music — the MP3 player.
 * Renders a native, accessible <audio> player per uploaded track. Data-driven
 * from src/data/music.ts; shows an honest empty state until Jon's recordings
 * land (drop an MP3 in public/audio/ and add a Track entry).
 */
import { tracks } from '../../data/music';
---

<section id="music" class="py-24" aria-labelledby="music-title">
  <div class="mx-auto max-w-2xl">
    <p class="eyebrow" id="music-eyebrow">Music</p>
    <h2 class="mt-3 text-display font-medium text-ink" id="music-title">Hear the set</h2>
    <p class="mt-4 max-w-2xl text-ink-soft">
      Recordings, when they're up — MP3s from the mic, the way the room hears them.
    </p>

    {
      tracks.length === 0 ? (
        <p class="mt-8 text-ink-soft">No recordings yet — the first takes land here soon.</p>
      ) : (
        <ul class="mt-8 grid gap-4">
          {tracks.map((t) => (
            <li class="gatefold">
              <p class="eyebrow">{t.title}</p>
              <audio class="mt-3 w-full" controls preload="none" src={t.src}>
                Your browser doesn't support the audio element.
              </audio>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
