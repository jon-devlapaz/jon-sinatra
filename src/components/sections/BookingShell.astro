---
/**
 * F08 — The Booking (LG3).
 * The React island hydrates the SSR form for inline validation, pending/
 * success/error states and endpoint delivery. Without JS the SSR `<form>`
 * still posts to the configured endpoint (mailto: by default).
 *
 * FORM_ENDPOINT is read at build time from `PUBLIC_FORM_ENDPOINT` (Astro env),
 * per the roadmap's endpoint-agnostic adapter default; unset → mailto handoff.
 */
import type { Profile } from '../../data/profile';
import BookingForm from '../booking/BookingForm';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
const packages = profile.packages.map((p) => ({ id: p.id, eyebrow: p.eyebrow }));
---

<section id="booking" class="py-24" aria-labelledby="booking-title">
  <div class="mx-auto max-w-2xl">
    <p class="eyebrow" id="booking-eyebrow">The Booking</p>
    <h2 class="text-display text-ivory" id="booking-title">Set the date</h2>
    <p class="mt-4 max-w-2xl text-ivory-dim">
      A note, a date, a package — I'll get back within 24 hours. (No spam; ever.)
    </p>

    <BookingForm
      client:load
      mailto={profile.contact.email}
      endpoint={endpoint}
      packages={packages}
    />
  </div>
</section>
