---
/**
 * F04 — Booking Shell (LG3 React island mount).
 * Mounts the BookingForm island for progressive enhancement.
 * The static BookingBar above handles the primary horizontal form.
 * This shell provides the detailed form experience (validation, states, endpoint delivery).
 */
import type { Profile } from '../../data/profile';
import BookingForm from '../booking/BookingForm';

interface Props {
  profile: Profile;
  packageId?: string;
  date?: string;
}

const { profile } = Astro.props;
const endpoint =
  (import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined) ||
  'https://formspree.io/f/mgawdnpp';
const packages = profile.packages?.map((p) => ({ id: p.id, eyebrow: p.eyebrow })) || [];
---

<div class="container-page py-section-gap" id="booking-form-shell" aria-labelledby="booking-form-title">
  <div class="mx-auto max-w-2xl">
    <p class="font-label text-subheading-caps text-primary" id="booking-form-eyebrow">Let’s talk about it</p>
    <h2 class="mt-3 font-display text-headline-md font-medium text-on-surface" id="booking-form-title">
      Tell me what you’re planning
    </h2>
    <p class="mt-4 max-w-2xl text-on-surface-variant font-light leading-loose">
      Tell me the date, the kind of event, and what you have in mind. I’ll get back to you as soon as I can.
    </p>

    <BookingForm
      client:load
      mailto={profile.contact.email}
      endpoint={endpoint}
      packages={packages}
    />
  </div>
</div>