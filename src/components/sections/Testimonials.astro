---
/**
 * F06 — The Word (testimonials).
 * Data-driven from the Astro Content Collection; typographic quotes only —
 * no emoji stars, mono venue/event attribution.
 */
import { getCollection } from 'astro:content';

const testimonials = await getCollection('testimonials');
---

<section id="word" class="border-b hairline-gold-b py-20" aria-labelledby="word-title">
  <div class="mx-auto max-w-3xl">
    <p class="eyebrow" id="word-eyebrow">The Word</p>
    <h2 class="text-display text-ivory" id="word-title">What they said</h2>

    {
      testimonials.length === 0 ? (
        <p class="mt-12 text-ivory-dim">No quotes yet — the mic is listening.</p>
      ) : (
        <div class="mt-12 grid gap-10 md:grid-cols-2">
          {testimonials.map((t) => (
            <blockquote class="border-l hairline-gold-l pl-6 italic">
              <p class="text-lg text-ivory">"{t.data.quote}"</p>
              <footer class="mt-3 font-mono text-mono text-gold">
                — {t.data.name}
                {t.data.venue && <>, {t.data.venue}</>}
                {t.data.eventType && <>, {t.data.eventType}</>}
              </footer>
            </blockquote>
          ))}
        </div>
      )
    }
  </div>
</section>
