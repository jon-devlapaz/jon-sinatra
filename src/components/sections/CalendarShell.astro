---
/**
 * F07 — The Calendar (LG3).
 * SSR-renders the React island month grid (progressive enhancement): no-JS
 * visitors still see the current month grid, JS users get full navigation and
 * date selection that prefills the booking form.
 */
import { format } from 'date-fns';
import CalendarWidget from '../calendar/CalendarWidget';

interface Props {
  /** ISO dates already booked — shown but not selectable. */
  bookedDates?: string[];
}

const { bookedDates = [] } = Astro.props;
const initialIsoMonth = format(new Date(), 'yyyy-MM');
---

<section id="calendar" class="py-24" aria-labelledby="calendar-title">
  <div class="mx-auto max-w-4xl">
    <p class="eyebrow" id="calendar-eyebrow">The Calendar</p>
    <h2 class="text-display text-ink" id="calendar-title">Tell me your date</h2>
    <p class="mt-4 max-w-2xl text-ink-soft">
      Striking dates are shown struck-through. Pick any open one — it prefills the booking form
      below.
    </p>

    <CalendarWidget client:load initialIsoMonth={initialIsoMonth} bookedDates={bookedDates} />
  </div>
</section>
