---
/**
 * F05 — The Stage (gallery).
 * Lazy-loaded, aspect-ratio media-frames (no JS). Images are configurable
 * per item; where no src exists yet, a themed placeholder frame renders.
 */
import type { GalleryItem, Profile } from '../../data/profile';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;

type GalleryWithSrc = GalleryItem & { src?: string };
---

<section id="stage" class="border-b hairline-gold-b py-20" aria-labelledby="stage-title">
  <div class="mx-auto max-w-5xl">
    <p class="eyebrow" id="stage-eyebrow">The Stage</p>
    <h2 class="text-display text-ivory" id="stage-title">From the room</h2>
    <p class="mt-4 max-w-2xl text-ivory-dim">
      Moments from recent evenings — low light, warm brass, the space between the notes.
    </p>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 md:grid-cols-3">
      {
        (profile.gallery as GalleryWithSrc[]).map((g) => (
          <figure class="media-frame overflow-hidden">
            {g.src ? (
              <img
                class="h-full w-full object-cover"
                src={g.src}
                alt={g.alt}
                loading="lazy"
                width="480"
                height="360"
              />
            ) : (
              <div class="absolute inset-0 grid place-items-center">
                <span class="font-mono text-mono text-gold">{g.label}</span>
              </div>
            )}
            <figcaption class="sr-only">{g.alt}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
