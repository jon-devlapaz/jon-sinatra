---
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<section class="section-gap border-t border-outline-variant/20" aria-label="Information">
  <div class="container-page grid gap-16 md:grid-cols-3 md:gap-gutter">
    <article id="press" class="scroll-mt-32" aria-labelledby="press-title">
      <p class="font-label text-label-sm text-primary">Press</p>
      <h2 class="mt-3 font-display text-headline-md text-on-surface" id="press-title">
        A warm, familiar sound for special occasions.
      </h2>
      <p class="mt-6 text-on-surface-variant font-light leading-loose">
        I’m building a small press kit with photos, a short biography, and performance details. For interviews, event coverage, or a photo request, please write to
        <a class="text-primary underline underline-offset-4" href={`mailto:${email}`}>{email}</a>.
      </p>
    </article>

    <article id="privacy" class="scroll-mt-32" aria-labelledby="privacy-title">
      <p class="font-label text-label-sm text-primary">Privacy</p>
      <h2 class="mt-3 font-display text-headline-md text-on-surface" id="privacy-title">
        Your note stays private.
      </h2>
      <p class="mt-6 text-on-surface-variant font-light leading-loose">
        I use the information you share only to reply, check availability, and understand what you’re planning. I don’t sell it or add you to a mailing list.
      </p>
    </article>

    <article id="terms" class="scroll-mt-32" aria-labelledby="terms-title">
      <p class="font-label text-label-sm text-primary">Terms</p>
      <h2 class="mt-3 font-display text-headline-md text-on-surface" id="terms-title">
        We’ll agree on the details together.
      </h2>
      <p class="mt-6 text-on-surface-variant font-light leading-loose">
        We’ll confirm the date, performance details, travel, and fee in writing before anything is final. A date is not held until we’ve agreed on the details together.
      </p>
    </article>
  </div>
</section>
